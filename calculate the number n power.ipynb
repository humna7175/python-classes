   "source": [
    "# Program to calculate the n-th power using a loop\n",
    "\n",
    "number = int(input(\"Enter the number: \"))\n",
    "power = int(input(\"Enter the power (n): \"))\n",
    "\n",
    "result = 1\n",
    "\n",
    "for i in range(power):\n",
    "    result = result * number\n",
    "\n",
    "print(\"Result =\", result)"
   ]
