    "def tip(amount,percentage):\n",
    "    tip=(percentage/100)*amount\n",
    "    print(\"the tip should be: Rs\",tip)\n",
    "    \n",
    "bill=int(input(\"enter the amount of bill:\"))\n",
    "t=int(input(\"enter tip percentage:\"))\n",
    "\n",
    "tip(bill,t)\n",
    " "
