    "import math\n",
    "n=int(input(\"enter the number:\"))\n",
    "if n==0 or n==1:\n",
    "    print(\"the fictorial is 1\")\n",
    "else:\n",
    "    f=math.factorial(n)\n",
    "    print(\"the fictorial is\",f)\n",
    "\n"
