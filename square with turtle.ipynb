    "import turtle\n",
    "t=turtle.Turtle()\n",
    "t.color(\"black\")\n",
    "\n",
    "turtle.bgcolor(\"red\")\n",
    "t.pensize(6)\n",
    "\n",
    "for i in range(4):\n",
    "    t.forward(100)\n",
    "    t.right(90)\n",
    "    \n",
    "turtle.done()\n",
    "    \n",
    "    \n",
    "\n"
   ]
