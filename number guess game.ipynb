   "source": [
    "import random\n",
    "num=random.randint(1,20)\n",
    "print(\"this is a number guess game,guess random between 1 and 20\")\n",
    "while True:\n",
    "    guess=int(input(\"enter the number\"))\n",
    "    if guess==num:\n",
    "        print(\"your guess is right\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"try again\")\n",
    "\n",
    "    \n"
   ]
